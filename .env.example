# ========================================================
# Django Settings
# ========================================================
DJANGO_SECRET_KEY=your-super-secret-key-here-generate-random
DEBUG=False
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://your-domain.com,http://your-ec2-ip:8000

# ========================================================
# Database Configuration (PostgreSQL / AWS RDS)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
# (Leave blank or omit to use SQLite)
# ========================================================
DATABASE_URL=postgres://postgres:postgrespassword@db:5432/smart_college_db

# ========================================================
# Email Configuration (for OTPs and Notifications)
# ========================================================
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# ========================================================
# AI Services & HuggingFace
# ========================================================
HUGGINGFACE_API_KEY=your_huggingface_api_key
OPENAI_API_KEY=
